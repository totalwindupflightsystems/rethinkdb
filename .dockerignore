# Keep the build context small: the repo is ~2.6GB with .git and build/.
.git
build/
scratch/

# Local build artifacts / configs (regenerated by ./configure inside the image)
config.mk
compile_commands.json
agent-sdlc-interaction-map.json

# Databases and lock files
*.db
*.db-shm
*.db-wal

# Fleet / agent state
.coding-hermes
.gitreins
.vfs
CRON_DISABLED

# Python / tooling caches
.venv
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.benchmarks
*.log
